; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Okçuların Son Kalesi"
config/version="1.0.0-rc"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.031, 0.118, 0.11, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/splash.png"
config/icon="res://assets/app_icon.png"

[autoload]

SaveManager="*res://scripts/save_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
AchievementManager="*res://scripts/achievement_manager.gd"
CosmeticManager="*res://scripts/cosmetic_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[layer_names]

3d_physics/layer_1="Road"
3d_physics/layer_2="Buildable"
3d_physics/layer_3="Environment"
3d_physics/layer_4="Castle"
3d_physics/layer_5="Enemy"
3d_physics/layer_6="Tower"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
